RewriteEngine On

# Limites de formulário/upload (reforço quando o PHP roda como módulo Apache).
# Necessário porque o form de edição de passeios pode gerar muitos campos e
# estourar o max_input_vars padrão (1000), o que faz o upload de imagens
# falhar silenciosamente em passeios com muita configuração/galeria.
<IfModule mod_php7.c>
    php_value max_input_vars 5000
    php_value post_max_size 64M
    php_value upload_max_filesize 32M
    php_value max_file_uploads 50
</IfModule>
<IfModule mod_php.c>
    php_value max_input_vars 5000
    php_value post_max_size 64M
    php_value upload_max_filesize 32M
    php_value max_file_uploads 50
</IfModule>

# Compressão Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Servir assets diretamente do /public
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
RewriteRule ^import\.png$ public/import.png [L]
RewriteRule ^favicon\.ico$ public/favicon.ico [L]

# Redirect antigo catalogo.html para nova rota
RewriteRule ^catalogo\.html$ /catalogo [R=301,L]

# Se o arquivo ou diretório existir na raiz, entrega direto
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Caso contrário, envia tudo para o front controller em /public
RewriteRule ^ public/index.php [L]
