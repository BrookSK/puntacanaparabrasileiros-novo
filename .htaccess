RewriteEngine On

# Limites de formulário/upload (reforço quando o PHP roda como módulo Apache).
# Necessário porque o form de edição de passeios pode gerar muitos campos e
# estourar o max_input_vars padrão (1000), o que faz o upload de imagens
# falhar silenciosamente em passeios com muita configuração/galeria.
<IfModule mod_php7.c>
    php_value max_input_vars 5000
    php_value post_max_size 64M
    php_value upload_max_filesize 32M
    php_value max_file_uploads 50
</IfModule>
<IfModule mod_php.c>
    php_value max_input_vars 5000
    php_value post_max_size 64M
    php_value upload_max_filesize 32M
    php_value max_file_uploads 50
</IfModule>

# Compressão Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Servir assets/uploads diretamente do /public.
# IMPORTANTE: só reescreve se o arquivo REALMENTE existir dentro de /public,
# e serve o arquivo direto (sem cair no front controller). Sem esta checagem,
# um /uploads/foto.jpg que não resolvesse escorregava até o index.php e o
# servidor devolvia uma página de erro em vez do arquivo — o que fazia as
# imagens aparecerem quebradas (X) e os documentos não baixarem.
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(assets/.*)$ public/$1 [L]

RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(uploads/.*)$ public/$1 [L]

RewriteRule ^import\.png$ public/import.png [L]
RewriteRule ^favicon\.ico$ public/favicon.ico [L]

# Redirect antigo catalogo.html para nova rota
RewriteRule ^catalogo\.html$ /catalogo [R=301,L]

# Se o arquivo ou diretório existir na raiz, entrega direto
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Caso contrário, envia tudo para o front controller em /public
RewriteRule ^ public/index.php [L]
